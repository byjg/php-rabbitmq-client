{
  "name": "byjg/rabbitmq-client",
  "description": "It creates a simple abstraction layer to publish and consume messages from the RabbitMQ Server using the component byjg/message-queue-client.",
  "autoload": {
    "psr-4": {
      "ByJG\\MessageQueueClient\\RabbitMQ\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": ">=8.3 <8.7",
    "ext-curl": "*",
    "byjg/message-queue-client": "^7.0",
    "php-amqplib/php-amqplib": "^3.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "psalm/phar": "^6.16"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "psalm": "vendor/bin/psalm.phar"
  },
  "license": "MIT"
}
